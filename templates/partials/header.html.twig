{# Returns the Tailwind classes for a nav link, depending on whether it is the current page #}
{% macro nav_class(is_active, offset = 4) -%}
  {%- if is_active -%}
    text-brand-dark underline underline-offset-{{ offset }} transition-colors duration-300
  {%- else -%}
    hover:text-brand-dark transition-colors duration-300
  {%- endif -%}
{%- endmacro %}

{% import _self as nav %}
{% set current_route = app.request.attributes.get('_route') %}

{#
  Home, Services, Partners, About, Login and Account use path(). Admin is
  still a plain path until that route exists; swap them for
  path('app_xxx') as each controller gets built.
#}

<header class="bg-brand-light">
  <div class="mx-[130px] flex justify-between items-center py-6">

    <!-- Logo Area -->
    <div class="flex items-center relative">
      <img src="{{ asset('pictures/logo.png') }}" alt="AM Security Logo" class="w-[60px] h-[60px] object-contain">
      <a href="{{ path('app_home') }}" class="font-eras text-[50px] text-brand-mid tracking-wide ml-[15px]">
        AM Security
      </a>
    </div>

    <!-- Center Navigation -->
    <nav class="flex gap-8 text-[25px] text-brand-mid">
      <a href="{{ path('app_home') }}" class="{{ nav.nav_class(current_route == 'app_home') }}">Home</a>
      <a href="{{ path('app_services') }}" class="{{ nav.nav_class(current_route == 'app_services') }}">Services</a>
      <a href="{{ path('app_partners') }}" class="{{ nav.nav_class(current_route == 'app_partners') }}">Partners</a>
      <a href="{{ path('app_about') }}" class="{{ nav.nav_class(current_route == 'app_about') }}">About Us</a>

      {% if app.user %}
        {% set display_name = app.user.userIdentifier %}
        <a href="{{ path('app_account') }}" class="{{ nav.nav_class(current_route == 'app_account') }}">
          {{ display_name|length > 8 ? display_name|slice(0, 8) ~ '...' : display_name }}
        </a>
      {% else %}
        <a href="{{ path('app_login') }}" class="{{ nav.nav_class(current_route == 'app_login', 8) }}">Login</a>
      {% endif %}

      {% if is_granted('ROLE_ADMIN') %}
        <a href="/admin" class="{{ nav.nav_class(current_route == 'app_admin') }}">Admin</a>
      {% endif %}
    </nav>

    <!-- Right Actions -->
    <div class="flex items-center gap-6 text-[30px] text-brand-mid">
      <a href="{{ path('app_home') }}#downloads" class="px-6 py-2 bg-brand-mid text-brand-dark rounded-xl transition-colors duration-300 hover:bg-brand-dark hover:text-brand-mid">Download</a>
    </div>

  </div>
</header>
